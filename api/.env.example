# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=Tur
# Chave para assinar tokens. Em produção: no mínimo 32 bytes aleatórios
# (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=dev-secret-change-me-dev-secret-change-me-0000
# URL pública do frontend (CORS e redirecionamentos). Aceita várias, separadas por vírgula.
FRONTEND_URL=http://localhost:5173,http://localhost:3000
# URL pública desta API (usada em links de e-mail e no callback do Google)
API_PUBLIC_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,api

# ---------------------------------------------------------------------------
# Banco e Redis (docker compose: Postgres na 5433, Redis na 6380)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://tur:tur@localhost:5433/tur
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# false = login desligado: o frontend escolhe o papel (turista/operadora/admin)
# e a API usa usuários de desenvolvimento. Proibido em produção.
AUTH_ENABLED=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Primeiro admin (criado pelo seed)
ADMIN_EMAIL=admin@tur.local
ADMIN_NAME=Admin

# Google OAuth (ver docs/integracoes.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# E-mail (SMTP). Em desenvolvimento, o Mailpit do docker compose (UI em http://localhost:8026)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tur <no-reply@tur.local>
SMTP_TLS=false

# ---------------------------------------------------------------------------
# Pagamentos (ver docs/integracoes.md). "fake" simula o gateway em desenvolvimento.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=fake
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_ENV=sandbox

# ---------------------------------------------------------------------------
# Arquivos (fotos). Vazio = disco local em ./media (só desenvolvimento).
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Mapa: geocodificação gratuita (photon | nominatim)
# ---------------------------------------------------------------------------
GEOCODING_PROVIDER=photon
GEOCODING_USER_AGENT=tur-dev (admin@tur.local)

# ---------------------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
